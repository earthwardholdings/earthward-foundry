# =============================================================================
# Earthward Foundry — .gitignore
# =============================================================================

# --- Secrets and credentials (NEVER committed) ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
secrets/
credentials/
*secret*
*credential*
*api_key*
*apikey*

# --- SQLite databases (local state, not source) ---
*.db
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.venv/
venv/
env/
ENV/
.python-version

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.orig

# --- Logs ---
*.log
logs/

# --- Node (if frontend ever added) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/
